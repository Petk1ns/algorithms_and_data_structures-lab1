from math import cos, sin

def f(x):
  return cos(2 / x) - 2 * sin(1 / x) + (1 / x) #заданная функция


L, R = 1, 16 #границы интервала
p = float(input()) #погрешность

while abs(R - L) > p:
  x = R - (f(R) * (L - R)) / (f(L) - f(R)) #формула для определения приближения
  if f(x) * f(L) > 0: #проверка, с какой стороны находится корень
    L = x
  else:
    R = x
    
print(x) #ответ
